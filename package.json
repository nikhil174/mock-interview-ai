{
  "name": "mock-interview-ai",
  "productName": "Mock Interview AI",
  "version": "0.1.0",
  "private": true,
  "description": "Practice interview answers and get structured feedback (DeepSeek)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/main/consent-core.test.ts src/main/session-core.test.ts",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.example.mockinterviewai",
    "productName": "Mock Interview AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
